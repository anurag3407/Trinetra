# ==============================================================================
# TRINETRA RUNTIME CONFIGURATION
# ==============================================================================
# Options: 'local' (offline demo, mock data, zero setup) | 'prod' (live database, real RPCs)
NEXT_PUBLIC_APP_ENV=local

# ------------------------------------------------------------------------------
# 1. AI COPILOT: OPENAI-COMPATIBLE ENDPOINT (OpenAI / OpenRouter / Ollama / Groq)
# ------------------------------------------------------------------------------
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (Optional in 'local' mode, Required in 'prod')
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & REALTIME (Optional in 'local' mode, Required in 'prod')
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
